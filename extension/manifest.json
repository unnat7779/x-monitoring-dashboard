{
  "manifest_version": 3,
  "name": "X Monitor — Real-Time Panel",
  "version": "2.1.0",
  "description": "Real-time breaking market intelligence & newswire feed from Indian financial media and analysts on X / Twitter.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://x-monitoring-dashboard.onrender.com/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open X Monitor Panel"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
