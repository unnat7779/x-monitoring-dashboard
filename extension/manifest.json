{
  "manifest_version": 3,
  "name": "X Monitor \u2014 Real-Time Panel",
  "version": "5.3.0",
  "description": "Real-time breaking market intelligence & newswire feed from Indian financial media and analysts on X / Twitter. Active 9:00 AM – 3:30 PM IST; idle otherwise.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "https://x-monitoring-dashboard.vercel.app/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "https://*.pusher.com/*",
    "wss://*.pusher.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open X Monitor Panel"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
